{
  "name": "@runespoorstack/testmo-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for the Testmo test management platform",
  "main": "index.js",
  "bin": {
    "testmo-mcp-server": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
