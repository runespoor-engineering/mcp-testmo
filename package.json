  },
  "dependencies": {
    "@testmo/testmo-api": "^2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runespoor-engineering/mcp-testmo.git"
  },
  "bugs": {
    "url": "https://github.com/runespoor-engineering/mcp-testmo/issues"
  },
  "author": {
    "name": "BorysShulyak",
    "email": "borysshulyak@gmail.com",
    "url": "https://github.com/BorysShulyak"
  },
  "maintainers": [
    {
      "name": "BorysShulyak",
      "email": "borysshulyak@gmail.com",
      "url": "https://github.com/BorysShulyak"
    }
  ],
  "lint-staged": {
    "*.{js,ts,json,jsonc}": "biome check --write"
  }
